# Copy to .env and adjust.
KASU_ENV=development
KASU_DATABASE_URL=postgresql+psycopg://kasu:kasu@127.0.0.1:5432/kasu
KASU_TEST_DATABASE_URL=postgresql+psycopg://kasu:kasu@127.0.0.1:5432/kasu_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KASU_JWT_SECRET=change-me
KASU_ACCESS_TOKEN_MINUTES=30
KASU_REFRESH_TOKEN_DAYS=30

# Where uploaded source files are kept (local disk for now; S3-compatible storage later).
KASU_UPLOAD_DIR=./var/uploads
KASU_MAX_UPLOAD_MB=20

# Frontend URL used in shareable invite links, and how long invites stay valid.
KASU_APP_URL=http://localhost:3000
KASU_INVITE_DAYS=7
